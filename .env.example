# ==============================================================================
# STUDIO LEANDRO RANGEL - Configuração de Ambiente
# ==============================================================================
# IMPORTANTE: Nunca versione credenciais de produção ou chaves de serviço neste arquivo.
#
# 0. Modo do site (OBRIGATÓRIO no build de produção; o build falha sem ele)
#    demo     = demonstração: dados fictícios só no navegador, nenhuma conta real
#    supabase = contas e dados reais no backend (pasta backend/, publicada à parte)
NEXT_PUBLIC_APP_MODE=demo

# 1. Supabase (só com NEXT_PUBLIC_APP_MODE=supabase)
# O site usa apenas a URL e a chave PÚBLICA: a "publishable" (sb_publishable_…), ou a "anon"
# em projetos antigos (NEXT_PUBLIC_SUPABASE_ANON_KEY). Painel: Project Settings → API Keys.
# Valores reais vão no .env.local (não versionado) e no painel da hospedagem, não aqui. A autorização acontece na RLS e nas
# Edge Functions do backend. A chave de serviço NÃO existe no site: não crie nenhuma variável
# com SERVICE ou SECRET no nome aqui (o build recusa NEXT_PUBLIC_ com esses nomes).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave

# 2. Configurações da Aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TRIAL_DURATION_DAYS=30
NEXT_PUBLIC_TIMEZONE=America/Sao_Paulo

# 3. Canais de Contato Institucional (se omitido, o sistema exibe estado indisponível honesto)
NEXT_PUBLIC_CONTACT_EMAIL=contato@studioleandrorangel.com.br
NEXT_PUBLIC_CONTACT_WHATSAPP=+5522992369997

# 4. Planos de assinatura (etapa 1: sem cobrança)
# Suporte prioritário do Completo: só aparece como "pronto" com as DUAS variáveis.
# Lidas no servidor (sem NEXT_PUBLIC_). Use um canal real definido pelo proprietário.
# PRIORITY_SUPPORT_CHANNEL_URL=mailto:suporte@seu-dominio.com.br
# PRIORITY_SUPPORT_HOURS=dias úteis, 9h às 18h
#
# Cobrança (Asaas): checkout hospedado + webhook nas Edge Functions do backend
# (billing e asaas-webhook). A chave do Asaas fica SÓ nos segredos do Supabase, nunca aqui.
# Ligue no site depois de configurar chave, token do webhook e URL no painel do Asaas:
# NEXT_PUBLIC_BILLING_ENABLED=true
# Desligada (padrão), as telas mostram "disponível em breve" e nada chama a cobrança.
# Login Google: configurado no Supabase (backend/), não aqui. O segredo do Google nunca entra no site.
